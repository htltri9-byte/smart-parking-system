# Mẫu cấu hình capture-agent. Copy thành .env (đã bị .gitignore) rồi sửa.
# Agent không tự đọc file này - hãy export biến môi trường (xem README) hoặc dùng
# trình quản lý biến môi trường của bạn.

# 0 / 1... = camera USB; hoặc http://IP:8080/video (IP Webcam); hoặc đường dẫn file video
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAPTURE_PORT=8002
JPEG_QUALITY=85
STALE_AFTER_S=5
