POSTGRES_USER=parking
POSTGRES_PASSWORD=change_me
POSTGRES_DB=parking

# Backend (trong Docker Compose, host là tên dịch vụ)
DATABASE_URL=postgresql+psycopg://parking:change_me@postgres:5432/parking
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_PREFIX=parking

# Backend giai doan 4 - luong cong (gia tri mac dinh da dung voi docker compose)
CAPTURE_URL=http://host.docker.internal:8002/capture
ALPR_URL=http://alpr:8001/recognize
GATE_OPEN_SECONDS=5
GATE_COOLDOWN_SECONDS=5
HTTP_TIMEOUT=10
IMAGE_DIR=data/images
